# ─────────────────────────────────────────────────────────────────────────────
# Predictive Pipeline Guardian — environment template.
# Copy to `.env` (in this folder) and fill in your values:
#     cp .env.example .env
# The Docker stack reads it via:  docker compose --env-file ../.env --profile full up
# ─────────────────────────────────────────────────────────────────────────────

# --- AI brain -----------------------------------------------------------------
# copilot        GitHub Copilot CLI (host/demo — needs a VS Code Copilot login)
# tardis         production in-cluster model seam
# auto           try Copilot, else transparent heuristic (safe in containers)
# The Copilot brain uses its own CLI login (your Copilot seat) — no model token.
BRAIN=auto

# GitHub Copilot CLI (only used when BRAIN=copilot on the host).
COPILOT_CLI_PATH=copilot
COPILOT_CLI_MODEL=

# Host GitHub Copilot standalone token dir (mounted read-only into the stack for
# the Claude Opus RCA brain). Leave BLANK to auto-resolve to the CURRENT user's
# profile (Windows %USERPROFILE%, else $HOME) — works on any machine. Set it only
# if your token.json lives somewhere else.
COPILOT_TOKEN_DIR=

# Optional fallback for the self-healing workflow when the Copilot CLI cannot
# produce a patch. Store the real value only in .env or a GitHub Actions secret.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- GitHub governance (REAL predicted-incident issue + gated preventive PR) ---
# A fine-grained PAT with: Contents (RW), Issues (RW), Pull requests (RW) on the
# target repo. Leave blank to run in "planned" mode (audited, no API calls).
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-user/Agent-AI-Thon

# Governance gate: false = file the predicted issue/PR automatically; true =
# show the dashboard approval button before filing. The guardian never merges
# post-production repair PRs; a human merge triggers its automatic recovery.
GOVERNANCE_REQUIRE_APPROVAL=false

# Live post-production recovery cadence (seconds / ticks).
GUARDIAN_LOOP_INTERVAL=6
GUARDIAN_MERGE_POLL_TICKS=2
GUARDIAN_RECOVERY_TICKS=4

# --- Guardian cadence ---------------------------------------------------------
# Seconds between guardian ticks inside the Airflow DAG task logic.
GUARDIAN_TICK_SECONDS=600

# --- Real-time source (Coinbase public API — no key required) -----------------
PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,ADA-USD
TRADES_PER_PRODUCT=50

# --- Kafka / Spark data plane -------------------------------------------------
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_TOPIC_RAW=trades-raw
KAFKA_TOPIC_AGG=trades-aggregated

# --- Postgres (Airflow metadata DB) ------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Grafana ------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_INTERNAL_URL=http://grafana:3000

# --- Grafana IRM / Incident (optional — a REAL incident on the predicted failure)
# The stack's Grafana is OSS, so the incident is ALWAYS surfaced as a tagged
# annotation on every board (the "Guardian incidents" marker). Provide a Grafana
# service-account token (with incident write) to ALSO declare a real Grafana IRM
# incident via the Incident API. Leave blank to run annotation-only (fully
# audited). GRAFANA_IRM_URL defaults to the Grafana URL; set it for Grafana Cloud.
GRAFANA_IRM_URL=
GRAFANA_IRM_TOKEN=
